# Enno production configuration.
# These are public, non-secret values. Copy this file to `.env` for local
# development, or set them as real shell environment variables / GitHub
# Actions vars, which take precedence over anything set here.

# Base URL of the production landing page (no trailing slash).
# Consumed by:
#   - the popup "open dashboard" link (`${VITE_LANDING_URL}/#dash`)
#   - the landing page canonical and og:url meta tags
#   - the extension externally_connectable.matches allowlist
VITE_LANDING_URL=https://enno-focus.pages.dev

# GitHub repository URL shown in the landing page header (star count is
# fetched live from the GitHub API).
VITE_GITHUB_URL=https://github.com/Daawnz/Enno

# Chrome Web Store listing URL for the landing page "Add to Chrome" button.
# Uncomment and set once the listing is published.
# VITE_STORE_URL=https://chromewebstore.google.com/detail/...

# Firefox (AMO) listing URL for the landing page "Add to Firefox" button.
# Uncomment and set once the listing is published.
# VITE_FIREFOX_URL=https://addons.mozilla.org/en-US/firefox/addon/...