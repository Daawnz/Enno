# Test-only placeholders for the store/AMO listing links.
#
# `npm run test:e2e` builds the landing with `--mode test` so Vite loads this
# file (plain `vite build` and production deployments keep using `.env` /
# `.env.production`, where these stay the real store URLs once published).
# The values only need to match what tests/landing.spec.ts asserts
# (chromewebstore.google.com/detail/... and addons.mozilla.org/...).
VITE_STORE_URL=https://chromewebstore.google.com/detail/enno-test
VITE_FIREFOX_URL=https://addons.mozilla.org/en-US/firefox/addon/enno-test