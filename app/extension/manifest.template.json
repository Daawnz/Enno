{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "description": "__MSG_description__",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "webNavigation", "offscreen"],
  "host_permissions": [],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocklist",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "browser_style": true,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-bg16.png",
      "32": "icons/icon-bg32.png",
      "48": "icons/icon-bg48.png",
      "64": "icons/icon-bg64.png",
      "128": "icons/icon-bg128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  }
}
